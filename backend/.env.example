# CareerPilot backend configuration
# Copy this file to .env (inside backend/) and adjust as needed.
# Never commit real API keys.

# Application environment: development | production
# In production mode, FastAPI docs/redoc/openapi endpoints are disabled.
APP_ENV=development

# LLM provider: mock | openai | deepseek | qwen
# "mock" runs fully offline with deterministic heuristics (no key needed).
LLM_PROVIDER=mock

# API key — required for openai/deepseek/qwen, ignored by mock.
LLM_API_KEY=

# Optional overrides for the chosen provider. Defaults per provider:
#   openai    -> model gpt-4o-mini,     base https://api.openai.com/v1
#   deepseek  -> model deepseek-chat,   base https://api.deepseek.com
#   qwen      -> model qwen-plus,       base https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=
LLM_BASE_URL=

# Provider request behavior.
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_RETRIES=2

# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted resume upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=10
